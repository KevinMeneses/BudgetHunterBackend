# Server Configuration
# Copy this file to .env.server and fill with your actual values
# DO NOT commit .env.server to Git!

SERVER_IP=YOUR_DROPLET_IP_HERE
SERVER_USER=root

# Public domain behind Nginx/SSL. Optional: when set, deploy.sh also verifies that
# https://$DOMAIN/actuator/health answers after deploying, and prints the public URLs.
DOMAIN=yourdomain.com
