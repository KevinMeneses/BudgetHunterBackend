# BudgetHunter Backend - Environment Variables
# Copy this file to .env and fill with your actual values
# DO NOT commit .env to Git!

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# PostgreSQL password for production
# Generate a secure random password (at least 32 characters)
# Example: openssl rand -base64 32
DATABASE_PASSWORD=your_secure_database_password_here

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
# Application HTTP port (default: 8080)
APP_PORT=8080

# ==============================================
# JWT CONFIGURATION
# ==============================================
# JWT secret key for token signing
# MUST be at least 256 bits (32 bytes) for HS256
# Generate with: openssl rand -base64 64
JWT_SECRET=your_secure_jwt_secret_key_at_least_64_characters_long_here

# JWT access token expiration in milliseconds (default: 24 hours)
# 86400000 ms = 24 hours
JWT_EXPIRATION=86400000

# JWT refresh token expiration in milliseconds (default: 7 days)
# 604800000 ms = 7 days
JWT_REFRESH_EXPIRATION=604800000

# ==============================================
# GOOGLE SIGN-IN
# ==============================================
# Comma-separated list of every OAuth client id allowed to issue an ID token for this app.
# Android tokens carry the *web* client id in "aud" (the app passes it as serverClientId);
# iOS tokens carry the *iOS* client id, so list both once the iOS app ships.
# Create them at https://console.cloud.google.com -> APIs & Services -> Credentials.
# Leave empty to disable Google sign-in (the endpoint then answers 401).
# One single line, no quotes, no trailing backslash - docker compose reads this file
# literally, not as a shell script.
GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

# ==============================================
# AUTOMATIC CATEGORIZATION (Gemini)
# ==============================================
# API key from https://aistudio.google.com/apikey. Leave empty to disable: with no key the server
# never calls Gemini. Only the normalised entry description is sent (no amounts, emails or names).
# The free tier may use submitted data to improve Google's products.
GEMINI_API_KEY=
# Model id. Google retires old ones, so check https://ai.google.dev/gemini-api/docs/models.
GEMINI_MODEL=gemini-3.5-flash-lite
# Requests to Gemini per minute; keep it under your plan's quota.
GEMINI_MAX_REQUESTS_PER_MINUTE=10
# false removes the categorize endpoint and the Gemini client altogether.
CATEGORIZATION_ENABLED=true

# ==============================================
# RECEIPT READING (Gemini, same GEMINI_API_KEY)
# ==============================================
# The app sends the whole receipt (image or PDF) here instead of calling Gemini itself.
RECEIPTS_GEMINI_MODEL=gemini-3.5-flash-lite
# Asked when the main model is overloaded (503 "high demand") or failing. Empty = retry the main one.
RECEIPTS_GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# How much Gemini 3 reasons before answering. "low" keeps a receipt fast; empty = the model's default (slow).
# Sent to both models: with a fallback that is not Gemini 3 (e.g. a 2.5 model), set this empty.
RECEIPTS_GEMINI_THINKING_LEVEL=low
# Seconds per attempt, for connecting and for the answer (two attempts at most per scan; the app gives up
# after 90 s in all). Must be positive.
RECEIPTS_GEMINI_TIMEOUT_SECONDS=30
# Receipt requests to Gemini per minute, for the whole server.
RECEIPTS_MAX_REQUESTS_PER_MINUTE=30
# Scans each plan includes per UTC calendar month. Premium's is a fair-use cap.
RECEIPTS_FREE_MONTHLY_SCANS=10
RECEIPTS_PREMIUM_MONTHLY_SCANS=200
# Scans one account may start per minute (failed scans are given back, so this stops free retries).
RECEIPTS_MAX_SCANS_PER_USER_PER_MINUTE=6
# Scans in flight at once on the server; above it a scan answers AI_BUSY (bounds memory and threads).
RECEIPTS_MAX_CONCURRENT_SCANS=8
# false removes the receipt endpoints altogether.
RECEIPTS_ENABLED=true
# Actuator endpoints to expose. Add "metrics" (health,metrics) to read the categorization.* counters
# at /actuator/metrics; they need a token. See MONITORING.md.
MANAGEMENT_ENDPOINTS_EXPOSED=health

# ==============================================
# SPRING PROFILES
# ==============================================
# Active profile: debug (development) or production
# - debug: Uses H2 in-memory database, verbose logging
# - production: Uses PostgreSQL, minimal logging
SPRING_PROFILES_ACTIVE=production

# ==============================================
# HOW TO USE
# ==============================================
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Generate secure secrets:
#    DATABASE_PASSWORD: openssl rand -base64 32
#    JWT_SECRET: openssl rand -base64 64
#
# 3. Edit .env and replace placeholder values with the generated secrets
#
# 4. Never commit .env to Git (it's already in .gitignore)
